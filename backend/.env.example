NODE_ENV=development
PORT=3001
JWT_SECRET=your-secret-min-32-chars-here!!!!!
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars!!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
DYNAMODB_ENDPOINT=http://localhost:8000
S3_BUCKET_ATTACHMENTS=taskflow-attachments-dev
S3_BUCKET_REPORTS=taskflow-reports-dev
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/taskflow-events
SES_FROM_EMAIL=noreply@taskflow.dev
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
